                <mxCell id="title" value="Arquitetura Medalhão Parametrizada &amp;amp; Ingestão API" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="90" y="10" width="700" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Exemplo de projeto para arquitetura medalhão no fabric utilizando lakehouses, spark notebooks e lakehouses." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#595959;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="90" y="44" width="500" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Como rodar:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• &lt;b&gt;Manual:&lt;/b&gt;&amp;nbsp;&lt;font&gt;Execute o notebook (1)&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: center;&quot;&gt;nb_bronze&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;, depois (2)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: center;&quot;&gt;nb_silver&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;, depois (3) nb_gold, em ordem. Cada notebook só funciona se o anterior tiver concluído (lê a camada anterior).&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;• &lt;b&gt;Opcional:&lt;/b&gt;&amp;nbsp;Orquestrar tudo com um &lt;b&gt;Data Pipeline&lt;/b&gt; do Fabric ou um notebook&amp;nbsp;&lt;b&gt;nb_main&lt;/b&gt;. Nesse caso toda a orquestração fica definida no próprio código, reduzindo a dependência a plataforma, pois pode ser aproveitada para DataBricks por exemplo.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="530" y="680" width="621" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="nb_bronze" value="&lt;div&gt;Notebook&lt;/div&gt;&lt;b&gt;nb_bronze&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F4000&quot; style=&quot;font-size: 10px;&quot;&gt;ingestão da API&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=13;size=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="39" y="171" width="150" height="92" as="geometry"/>
